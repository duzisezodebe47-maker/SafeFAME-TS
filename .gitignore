# ---- Python ----
.venv/
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# ---- Large reproducible artifacts ----
outputs/**
data_processed/
tmp/

# Keep compact, human-readable evidence in Git. Full predictions, weights,
# permutation distributions and logs remain in the LFS support archive.
!outputs/safefame_v2/
!outputs/safefame_v2/*.csv
!outputs/safefame_v2/*.json
!outputs/reviewer_sensitivity/
!outputs/reviewer_sensitivity/*.csv
!outputs/reviewer_sensitivity/*.json
!outputs/reviewer_sensitivity/*.png
!outputs/revision_comparison/
!outputs/revision_comparison/*.csv
!outputs/revision_comparison/*.json
!outputs/revision_comparison/*.png
!outputs/safefame_v4/
!outputs/safefame_v4/*.csv
!outputs/safefame_v4/*.json
!outputs/attribution_audit_v4/
!outputs/attribution_audit_v4/*.csv
!outputs/attribution_audit_v4/*.json
!outputs/attribution_audit_v4/*.png
!outputs/ett_benchmark/
