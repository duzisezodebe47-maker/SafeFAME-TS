# Preserve the line endings used when each class of evidence was recorded.
*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.tsv text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
requirements.txt text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Python-generated compact outputs were recorded with Windows CRLF bytes.
outputs/**/*.csv text eol=crlf
outputs/**/*.json text eol=crlf
outputs/**/*.txt text eol=crlf

# Frozen master experiment snapshots must preserve recorded bytes across checkout.
team_work/main/round11/** -text
team_work/main/round12/** -text
team_work/main/round13/** -text
team_work/main/round14/** -text
team_work/main/round15/** -text
team_work/main/round16/** -text
